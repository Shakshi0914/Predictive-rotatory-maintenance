# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# HiveMQ Cloud MQTT Broker Configuration
# ==========================================
MQTT_BROKER_HOST="your-cluster-id.s1.eu.hivemq.cloud"
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=True
MQTT_USERNAME="iot_telemetry_user"
MQTT_PASSWORD="YourStrongMqttPassword123!"
MQTT_TOPIC_PREFIX="plant1"
MQTT_CLIENT_ID="iot_ingest_service_01"

# Public fallback broker (if HiveMQ Cloud is not configured)
MQTT_FALLBACK_HOST="broker.hivemq.com"
MQTT_FALLBACK_PORT=1883

# ==========================================
# Database & Ingestion Configuration
# ==========================================
SQLITE_DB_PATH="iot_machinery.db"
CSV_BACKUP_PATH="data/telemetry_backup.csv"
CSV_TRAINING_DATASET_PATH="data/rotary_machinery_training.csv"
MODEL_DIR="models"

# ==========================================
# Thresholds (Rule-Based Anomaly Detection)
# ==========================================
THRESH_VIB_RMS_WARNING=4.5
THRESH_VIB_RMS_CRITICAL=7.0
THRESH_TEMP_CRITICAL=85.0
THRESH_KURTOSIS_WARNING=3.8
ALERT_DEDUP_SECONDS=30

# ==========================================
# Alert Dispatch Channels (Config at least one)
# ==========================================
# 1. Generic Webhook (Slack, Discord, PagerDuty, Zapier, custom endpoint)
WEBHOOK_URL="https://httpbin.org/post"

# 2. Telegram Bot Notifications
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# 3. Email Alerts (SMTP)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="alert-notifications@yourplant.com"
SMTP_PASSWORD="your-app-password"
ALERT_EMAIL_RECIPIENT="maintenance-lead@yourplant.com"

# ==========================================
# Web Dashboard & Auth Settings
# ==========================================
SECRET_KEY="super-secret-key-change-in-production-12345"
DEFAULT_ADMIN_USER="admin"
DEFAULT_ADMIN_PASSWORD="AdminChangeMe123!"
PORT=3000

